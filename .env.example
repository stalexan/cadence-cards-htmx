# Copy to .env and fill in. Read by both `docker compose` and the app itself
# (config.Load reads ./.env at startup), so a bare `go run ./cmd/cadence` picks
# these up locally.
#
# A variable already set in the environment is never overwritten by this file,
# so `VAR=x go run ./cmd/cadence` still overrides for one run.
#
# Syntax: KEY=VALUE, one per line; `#` comments must be on their own line.
# An unquoted value runs to end of line (no inline-comment stripping), so quote
# any value containing '#' -- e.g. PASSWORD="a#b".

# External Docker network the reverse proxy lives on (created separately:
#   docker network create cadence-cards-shared)
SHARED_NETWORK_NAME=cadence-cards-shared

# Timezone for SM-2 day-boundary math ("a card is due N days later" uses
# local midnights). Set to your users' timezone.
TZ=UTC

# Shown in the sidebar footer.
APP_VERSION=1.0.0

# Claude API (study question generation + chat)
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=4000

# Allow anyone to register an account. When false, create users with:
#   docker compose run --rm app -create-user you@example.com
ENABLE_PUBLIC_REGISTRATION=false

# --- local `go run` only ---
# These now take effect for a local `go run`, so uncommenting DB_PATH and
# COOKIE_SECURE lets you start with a bare `go run ./cmd/cadence`.
# They still do nothing for the container: docker-compose.yml hardcodes PORT and
# DB_PATH and does not forward COOKIE_SECURE or DISABLE_RATE_LIMITING -- add them
# to the compose `environment:` block if you need them there.
# PORT=3000
# DB_PATH=./dev.db
# COOKIE_SECURE=false         # set false only when serving plain HTTP
# DISABLE_RATE_LIMITING=true  # dev only
