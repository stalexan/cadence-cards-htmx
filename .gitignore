# Secrets / local config
.env
.env.*
!.env.example

# SQLite databases (dev.db, e2e runs) incl. WAL sidecar files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Build artifacts (binary name matches cmd/cadence)
/cadence
/cadence-cards
dist/
bin/

# Test & profiling output
*.test
*.out
coverage.html
*.prof

# Backups (README suggests backup-YYYY-MM-DD.db copies)
backup-*.db
*.bak

# Editor / OS noise
.idea/
.vscode/
*.swp
*~
.DS_Store
# macOS AppleDouble resource forks (go:embed skips them, git shouldn't see them)
._*
.AppleDouble
__MACOSX/

# Misc
tmp/
